# ==============================================================================
# FREELANCE PORTFOLIO & CMS ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL / Cloud Database)
# ------------------------------------------------------------------------------
# The portfolio uses MySQL for persistent cloud data storage across deployments.
# When MYSQL_URL or DATABASE_URL is set, the application automatically:
# - Connects with an optimized connection pool (mysql2)
# - Creates all required tables (profiles, services, projects, process_steps, testimonials, inquiries, admins)
# - Seeds default portfolio projects & admin credentials if empty
# - Persists all admin changes (project additions, edits, deletes, inquiries) 24/7
#
# Free cloud MySQL providers you can use:
# - Aiven for MySQL (Free tier: https://aiven.io)
# - TiDB Cloud Serverless (Free tier: https://tidbcloud.com)
# - Railway MySQL (https://railway.app)
# - Clever Cloud MySQL (Free tier: https://www.clever-cloud.com)
# - PlanetScale (https://planetscale.com)

# Option A: Single Connection URI (Recommended for Vercel / Railway / Cloud)
MYSQL_URL=mysql://username:password@hostname:3306/database_name

# Or use standard DATABASE_URL:
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Option B: Individual Connection Parameters (Alternative)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=portfolio
# MYSQL_SSL=true

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic session secret used for JWT signing (minimum 32 characters)
SESSION_SECRET=portfolio-nextjs-super-secret-jwt-key-2026-secure-production-random-value

# Initial password assigned when the database is seeded for the first time
# Default is 'admin123' if left blank. Can be updated anytime in the /admin/security tab.
INITIAL_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 3. PUBLIC SITE URL (Used for sitemap and SEO canonical tags)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
