# ==============================================================================
# FREELANCE PORTFOLIO & CMS ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas Cloud Database)
# ------------------------------------------------------------------------------
# The portfolio connects to MongoDB Atlas for persistent cloud storage.
# Paste your connection string from MongoDB Atlas:
# - Works with MongoDB Compass on your PC for local visual viewing and editing
# - Connects your Vercel deployment 24/7 with auto-reconnecting connection pool
# - Automatically creates & seeds collections (profiles, projects, services, etc.) if empty
#
# Free MongoDB Atlas setup:
# 1. Sign up at https://www.mongodb.com/cloud/atlas/register (Free M0 Shared cluster)
# 2. Add an IP Access rule: Allow Access from Anywhere (0.0.0.0/0)
# 3. Create a database user & password
# 4. Copy the connection string into MONGODB_URI below:
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority

# Optional: Custom database name (default: portfolio)
MONGODB_DB=portfolio

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic session secret used for JWT signing (minimum 32 characters)
SESSION_SECRET=portfolio-nextjs-super-secret-jwt-key-2026-secure-production-random-value

# Initial password assigned when the database is seeded for the first time
# Default is 'admin123' if left blank. Can be updated anytime in the /admin/security tab.
INITIAL_ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 3. PUBLIC SITE URL (Used for sitemap and SEO canonical tags)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
